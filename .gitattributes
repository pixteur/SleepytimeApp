# Normalize line endings: store text as LF in the repo so CI (Linux) and the
# `dart format` check stay consistent regardless of contributor OS.
* text=auto eol=lf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary
*.so binary
*.dll binary
*.exe binary
