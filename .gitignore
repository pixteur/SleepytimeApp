# ── Secrets (NEVER commit API keys) ───────────────────────────────
# NOTE: do NOT add a bare `**/secrets/` rule — it silently swallows the source
# directory lib/adapters/secrets/. Keys are stored at runtime via OS-secure
# storage (DPAPI), never in the repo.
*.env
.env*
secrets.json
api_keys.json
/secrets/

# ── Flutter / Dart ────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
flutter_*.png
**/doc/api/
*.lock.bak

# Generated code: we COMMIT Drift/codegen output (*.g.dart, *.freezed.dart) so
# CI doesn't need a build_runner step and the format check stays simple.
# Regenerate with: dart run build_runner build
*.mocks.dart
coverage/
*.iml

# ── Platform: Windows ─────────────────────────────────────────────
windows/flutter/ephemeral/

# ── Platform: macOS / iOS ─────────────────────────────────────────
**/Pods/
*.xcworkspace
ios/Flutter/ephemeral/
macos/Flutter/ephemeral/
**/xcuserdata/
**/.symlinks/
DerivedData/

# ── IDE / OS ──────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.DS_Store
Thumbs.db

# ── Local app data (test profiles, generated stories) ─────────────
local_data/
*.sleepytime.db
